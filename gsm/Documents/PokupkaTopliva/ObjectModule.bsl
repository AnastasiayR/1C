
#Область ОбработчикиСобытий
Процедура ОбработкаПроведения(Отказ, Режим)

	ПоследняяЦена = РегистрыСведений.ЦенаТоплива.ПолучитьПоследнее(Дата, Новый СТруктура("АЗС, ВидТоплива",АЗС,ВидТоплива));
	
	Если ПоследняяЦена.Цена <> Цена Тогда 
		Движения.ЦенаТоплива.Записывать = Истина;
		Движение 		 	=  Движения.ЦенаТоплива.Добавить();
		Движение.Период  	= Дата;
		Движение.АЗС 	  	= АЗС;
		Движение.ВидТоплива = ВидТоплива;
		Движение.Цена 		= Цена;  
	КонецЕсли;
	
	Движения.ОстаткиТоплива.Записывать = Истина; 
	Движение = Движения.ОстаткиТоплива.Добавить();
	Движение.ВидДвижения 	= ВидДвиженияНакопления.Приход;
	Движение.Период 		= Дата;
	Движение.Склад 			= Склад;
	Движение.ВидТоплива 	= ВидТоплива;
	Движение.Количество 	= Количество;

КонецПроцедуры

#КонецОбласти
