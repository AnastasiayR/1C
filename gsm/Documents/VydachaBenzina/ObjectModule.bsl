#Область ОбработчикиСобытий
Процедура ОбработкаПроведения(Отказ, Режим)

	// регистр ОстаткиТопливаПоАвто Прихид
	Движения.ОстаткиТопливаПоАвто.Записывать = Истина;
	Для Каждого ТекСтрокаСписок Из Список Цикл
		Движение 				= Движения.ОстаткиТопливаПоАвто.Добавить();
		Движение.ВидДвижения	= ВидДвиженияНакопления.Приход;
		Движение.Период 		= Дата;
		Движение.Машина 		= ТекСтрокаСписок.Машина;
		Движение.Количество 	= ТекСтрокаСписок.Количество;
	КонецЦикла;

	// регистр ОстаткиТоплива Расход
	Движения.ОстаткиТоплива.Записывать = Истина;
	Для Каждого ТекСтрокаСписок Из Список Цикл
		Движение 				= Движения.ОстаткиТоплива.Добавить();
		Движение.ВидДвижения 	= ВидДвиженияНакопления.Расход;
		Движение.Период 		= Дата;
		Движение.Склад 			= Склад;
		Движение.ВидТоплива 	= ТекСтрокаСписок.ВидТоплива;
		Движение.Количество 	= ТекСтрокаСписок.Количество;
	КонецЦикла;
	
	Движения.Записать();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВыдачаБензинаСписок.Машина КАК Машина,
		|	ВыдачаБензинаСписок.ВидТоплива КАК ВидТоплива,
		|	СУММА(ВыдачаБензинаСписок.Количество) КАК Количество,
		|	Автомобили.ОбъемБензобака КАК АвтоОбъемБензобака,
		|	ВЫБОР
		|		КОГДА Автомобили.ВидТоплива = ВидыТоплива.ТипТоплива
		|			ТОГДА ВЫБОР
		|					КОГДА Автомобили.ВидТоплива = ЗНАЧЕНИЕ(Перечисление.ТипыТоплива.Бензин)
		|							И Автомобили.ДопускАИ > ВидыТоплива.ЧислоАИ
		|						ТОГДА ЛОЖЬ
		|					ИНАЧЕ ИСТИНА
		|				КОНЕЦ
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Проверка
		|ПОМЕСТИТЬ ВТ_Список
		|ИЗ
		|	Документ.ВыдачаБензина.Список КАК ВыдачаБензинаСписок
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Автомобили КАК Автомобили
		|		ПО ВыдачаБензинаСписок.Машина = Автомобили.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыТоплива КАК ВидыТоплива
		|		ПО ВыдачаБензинаСписок.ВидТоплива = ВидыТоплива.Ссылка
		|ГДЕ
		|	ВыдачаБензинаСписок.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ВыдачаБензинаСписок.Машина,
		|	ВыдачаБензинаСписок.ВидТоплива,
		|	Автомобили.ОбъемБензобака,
		|	ВЫБОР
		|		КОГДА Автомобили.ВидТоплива = ВидыТоплива.ТипТоплива
		|			ТОГДА ВЫБОР
		|					КОГДА Автомобили.ВидТоплива = ЗНАЧЕНИЕ(Перечисление.ТипыТоплива.Бензин)
		|							И Автомобили.ДопускАИ > ВидыТоплива.ЧислоАИ
		|						ТОГДА ЛОЖЬ
		|					ИНАЧЕ ИСТИНА
		|				КОНЕЦ
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОстаткиТопливаПоАвтоОстатки.Машина КАК Машина,
		|	ВТ_Список.АвтоОбъемБензобака - ЕСТЬNULL(ОстаткиТопливаПоАвтоОстатки.КоличествоОстаток, 0) КАК ПроверкаБензобака
		|ПОМЕСТИТЬ ВТ_ОстаткиПоАвто
		|ИЗ
		|	ВТ_Список КАК ВТ_Список
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТопливаПоАвто.Остатки(
		|				&МоментВремени,
		|				Машина В
		|					(ВЫБРАТЬ
		|						ВТ_Список.Машина КАК Машина
		|					ИЗ
		|						ВТ_Список КАК ВТ_Список)) КАК ОстаткиТопливаПоАвтоОстатки
		|		ПО ВТ_Список.Машина = ОстаткиТопливаПоАвтоОстатки.Машина
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиТопливаПоАвтоОстатки.Машина,
		|	ВТ_Список.АвтоОбъемБензобака - ЕСТЬNULL(ОстаткиТопливаПоАвтоОстатки.КоличествоОстаток, 0)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОстаткиТопливаОстатки.ВидТоплива КАК ВидТоплива,
		|	ОстаткиТопливаОстатки.КоличествоОстаток КАК КоличествоОстаток
		|ПОМЕСТИТЬ ВТ_ОстаткиОбщие
		|ИЗ
		|	РегистрНакопления.ОстаткиТоплива.Остатки(
		|			&МоментВремени,
		|			Склад = &Склад
		|				И ВидТоплива В
		|					(ВЫБРАТЬ
		|						ВТ_Список.ВидТоплива КАК ВидТоплива
		|					ИЗ
		|						ВТ_Список КАК ВТ_Список)) КАК ОстаткиТопливаОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиТопливаОстатки.ВидТоплива,
		|	ОстаткиТопливаОстатки.КоличествоОстаток
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Список.Машина КАК Машина,
		|	ВТ_Список.Проверка КАК Проверка,
		|	NULL КАК ПроверкаБензобака,
		|	ВТ_Список.ВидТоплива КАК ВидТоплива
		|ИЗ
		|	ВТ_Список КАК ВТ_Список
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОстаткиПоАвто КАК ВТ_ОстаткиПоАвто
		|		ПО ВТ_Список.Машина = ВТ_ОстаткиПоАвто.Машина
		|ГДЕ
		|	ВТ_Список.Проверка = ЛОЖЬ
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_Список.Машина,
		|	ВТ_Список.Проверка,
		|	ВТ_Список.ВидТоплива
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВТ_Список.Машина,
		|	NULL,
		|	ВТ_ОстаткиПоАвто.ПроверкаБензобака,
		|	NULL
		|ИЗ
		|	ВТ_Список КАК ВТ_Список
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОстаткиПоАвто КАК ВТ_ОстаткиПоАвто
		|		ПО ВТ_Список.Машина = ВТ_ОстаткиПоАвто.Машина
		|ГДЕ
		|	(ВТ_Список.Проверка = ЛОЖЬ
		|			ИЛИ ВТ_ОстаткиПоАвто.ПроверкаБензобака < 0)
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_Список.Машина,
		|	ВТ_ОстаткиПоАвто.ПроверкаБензобака
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Список.ВидТоплива КАК ВидТоплива,
		|	ВТ_ОстаткиОбщие.КоличествоОстаток КАК КоличествоОстаток
		|ИЗ
		|	ВТ_Список КАК ВТ_Список
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОстаткиОбщие КАК ВТ_ОстаткиОбщие
		|		ПО ВТ_Список.ВидТоплива = ВТ_ОстаткиОбщие.ВидТоплива
		|ГДЕ
		|	ВТ_ОстаткиОбщие.КоличествоОстаток < 0
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_Список.ВидТоплива,
		|	ВТ_ОстаткиОбщие.КоличествоОстаток";
	
	Запрос.УстановитьПараметр("МоментВремени", Новый Граница(МоментВремени(), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса	= Запрос.ВыполнитьПакет();
	ПакетПоАвто 		= РезультатЗапроса[3];
	ПакетПоОстаткам 	= РезультатЗапроса[4];
	ВыборкаПоАвто 		= ПакетПоАвто.Выбрать();
	ВыборкаПоОстатка 	= ПакетПоОстаткам.Выбрать();
	
	Пока ВыборкаПоАвто.Следующий() Цикл 
		Отказ = Истина;
		
		Если ВыборкаПоАвто.Проверка = Ложь Тогда
			Текст = СтрШаблон("Недопустимое топливо для %1, %2", ВыборкаПоАвто.Машина, ВыборкаПоАвто.ВидТоплива); 
			Общий.СообщениеПользователю(Текст);
		ИначеЕсли ВыборкаПоАвто.ПроверкаБензобака < 0 Тогда
			Текст = СтрШаблон("Выдано больше вместимости бензобака для %1", ВыборкаПоАвто.Машина); 
			Общий.СообщениеПользователю(Текст);
		КонецЕсли;
		
	КонецЦикла; 
	
	Пока  ВыборкаПоОстатка.Следующий() Цикл
		Отказ = Истина;
		Текст = СтрШаблон("Недостаточно остатков топлива %1",ВыборкаПоОстатка.ВидТоплива); 
		Общий.СообщениеПользователю(Текст);
	КонецЦикла;
	

КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)

	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПокупкаТоплива") Тогда

		Склад 					= ДанныеЗаполнения.Склад;   
		ВведенНаОсновании 		= ДанныеЗаполнения;
		НоваяСтрока 			= ЭтотОбъект.Список.Добавить();
		НоваяСтрока.ВидТоплива 	= ДанныеЗаполнения.ВидТоплива;
		НоваяСтрока.Количество 	= ДанныеЗаполнения.Количество;
		
	КонецЕсли;

КонецПроцедуры  

#КонецОбласти
