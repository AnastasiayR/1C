#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Объект.ВыборРежима = 0 Тогда
		Объект.ВыборРежима = 1;
	КонецЕсли; 
	
	ПереключениеРежима(); 
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	ОчиститьПолеРасходВЛитрах();
	
КонецПроцедуры

&НаКлиенте
Процедура МашинаПриИзменении(Элемент)
	
	ОчиститьПолеРасходВЛитрах();
	
КонецПроцедуры

&НаКлиенте
Процедура ПробегПриИзменении(Элемент)
	
	ОчиститьПолеРасходВЛитрах(); 
	
КонецПроцедуры 

&НаКлиенте
Процедура РежиВводаПриИзменении(Элемент) 
		
	Если Объект.ВыборРежима = 1 Тогда
		Если Объект.Список.Количество() > 1 Тогда
			Ответ = Вопрос("Строки будут очищены. Продолжить?", РежимДиалогаВопрос.ДаНет);
			Если Ответ = КодВозвратаДиалога.Нет Тогда 
				Объект.ВыборРежима = 2; 
				Возврат;
			Иначе 
				ПеренестиПервуюСтрокуИзТЧ();
				Объект.Список.Очистить();
			КонецЕсли;
		ИначеЕсли Объект.Список.Количество() = 1 Тогда
			ПеренестиПервуюСтрокуИзТЧ();
			Объект.Список.Очистить();
		КонецЕсли;
	Иначе
		Если ЗначениеЗаполнено(Объект.Машина) ИЛИ ЗначениеЗаполнено(Объект.Пробег) Тогда 
			НоваяСтрока 				= Объект.Список.Добавить();
			НоваяСтрока.Машина 			= Объект.Машина;
			НоваяСтрока.Пробег 			= Объект.Пробег; 
			НоваяСтрока.РасходВЛитрах 	= Объект.РасходВЛитрах;

			Объект.Машина 			= Объект.Машина.Пустая();
			Объект.Пробег 			= 0; 
			Объект.РасходВЛитрах 	= 0;
		КонецЕсли;
	КонецЕсли; 
	Объект.Расчитан = Ложь;
	ПереключениеРежима();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокМашинаПриИзменении(Элемент)
	
	ОчиститьПолеТЧРасходВЛитрах();

КонецПроцедуры

&НаКлиенте
Процедура СписокПробегПриИзменении(Элемент)
	
	ОчиститьПолеТЧРасходВЛитрах();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура РасчитатьРасход(Команда) 
	
	Ответ = Вопрос("Для Расчета необходимо записать Документ. Сохранить?",РежимДиалогаВопрос.ДаНет);	
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПараметрыЗаписи = Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Запись);
		Если ЭтаФорма.ПроверитьЗаполнение() Тогда
			ЗаписьДокумента = ЭтаФорма.Записать(ПараметрыЗаписи);
			Объект.Расчитан = Истина;
            РасчитатьРасходНаСервере();
		Иначе 
			Возврат
	
		КонецЕсли; 
	КонецЕсли;
	
КонецПроцедуры 

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПереключениеРежима()
	
	Если Объект.ВыборРежима = 1 Тогда
		Элементы.Одиночный.Видимость	= Истина;  
		Элементы.Списком.Видимость		= Ложь;
	Иначе
		Элементы.Одиночный.Видимость 	= Ложь;  
		Элементы.Списком.Видимость 		= Истина; 
	КонецЕсли;
	
КонецПроцедуры

Процедура ПеренестиПервуюСтрокуИзТЧ()
	Объект.Машина = Объект.Список[0].Машина;
	Объект.Пробег = Объект.Список[0].Пробег;	
	Объект.РасходВЛитрах = Объект.Список[0].РасходВЛитрах;	

КонецПроцедуры
&НаКлиенте
Процедура ОчиститьПолеРасходВЛитрах()
	
	Объект.РасходВЛитрах 	= 0;
	Объект.Расчитан 		= Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьПолеТЧРасходВЛитрах()
	
	ТекСтрока = Элементы.Список.ТекущиеДанные;
	ТекСтрока.РасходВЛитрах = 0;
	Объект.Расчитан = Ложь;  
	
КонецПроцедуры


&НаСервере
Процедура РасчитатьРасходНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РасходТопливаПоПробегуСписок.Машина КАК Машина,
		|	РасходТопливаПоПробегуСписок.НомерСтроки КАК НомерСтроки
		|ПОМЕСТИТЬ ВТ_СписокАвто
		|ИЗ
		|	Документ.РасходТопливаПоПробегу.Список КАК РасходТопливаПоПробегуСписок
		|ГДЕ
		|	РасходТопливаПоПробегуСписок.Ссылка = &Ссылка
		|	И РасходТопливаПоПробегуСписок.Машина <> ЗНАЧЕНИЕ(Справочник.Автомобили.ПустаяСсылка)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	РасходТопливаПоПробегу.Машина,
		|	NULL
		|ИЗ
		|	Документ.РасходТопливаПоПробегу КАК РасходТопливаПоПробегу
		|ГДЕ
		|	РасходТопливаПоПробегу.Ссылка = &Ссылка
		|	И РасходТопливаПоПробегу.Машина <> ЗНАЧЕНИЕ(Справочник.Автомобили.Пустаяссылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Автомобили.РасходТоплива КАК РасходТоплива,
		|	Автомобили.ПробегНачальный КАК ПробегНачальный,
		|	ВТ_СписокАвто.Машина КАК Машина,
		|	ВТ_СписокАвто.НомерСтроки КАК НомерСтроки
		|ПОМЕСТИТЬ ВТ_Список
		|ИЗ
		|	ВТ_СписокАвто КАК ВТ_СписокАвто
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Автомобили КАК Автомобили
		|		ПО ВТ_СписокАвто.Машина = Автомобили.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПробегСрезПоследних.Машина КАК Машина,
		|	ПробегСрезПоследних.Пробег КАК Пробег
		|ПОМЕСТИТЬ ВТ_Пробег
		|ИЗ
		|	РегистрСведений.Пробег.СрезПоследних(
		|			&МоментВремени,
		|			Машина В
		|				(ВЫБРАТЬ
		|					ВТ_Список.Машина КАК Машина
		|				ИЗ
		|					ВТ_Список КАК ВТ_Список)) КАК ПробегСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Список.РасходТоплива КАК РасходТоплива,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ВТ_Пробег.Пробег, 0) = 0
		|			ТОГДА ВТ_Список.ПробегНачальный
		|		ИНАЧЕ ВТ_Пробег.Пробег
		|	КОНЕЦ КАК Пробег,
		|	ВТ_Список.Машина КАК Машина,
		|	ВТ_Список.НомерСтроки КАК НомерСтроки
		|ИЗ
		|	ВТ_Список КАК ВТ_Список
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Пробег КАК ВТ_Пробег
		|		ПО ВТ_Список.Машина = ВТ_Пробег.Машина
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
	
	
	Запрос.УстановитьПараметр("МоментВремени", Новый Граница(Новый МоментВремени(Объект.Дата, Объект.Ссылка), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если Объект.ВыборРежима = 1 Тогда  
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Прирост = Объект.Пробег - ВыборкаДетальныеЗаписи.Пробег;
			Объект.РасходВЛитрах = Окр(Прирост/ 100 * ВыборкаДетальныеЗаписи.РасходТоплива, 2, РежимОкругления.Окр15как20);  
		КонецЦикла;

	Иначе 
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			ТекущаяСтрока = Объект.Список.Получить(ВыборкаДетальныеЗаписи.НомерСтроки - 1);
			Прирост = ТекущаяСтрока.Пробег - ВыборкаДетальныеЗаписи.Пробег ;
			ТекущаяСтрока.РасходВЛитрах = Окр(Прирост/ 100 * ВыборкаДетальныеЗаписи.РасходТоплива, 2, РежимОкругления.Окр15как20);
		КонецЦикла; 
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти




