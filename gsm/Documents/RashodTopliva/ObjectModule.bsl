#Область ОбработчикиСобытий 

Процедура ОбработкаПроведения(Отказ, Режим) 
	
	Движения.Пробег.Записывать = Истина;
	Движения.ОстаткиТопливаПоАвто.Записывать = Истина;
	
	Если ВыборРежима = 1 Тогда
		// регистр Пробег
		Движение 		= Движения.Пробег.Добавить();
		Движение.Период = Дата;
		Движение.Машина = Машина;
		Движение.Пробег = Пробег;
		
		// регистр ОстаткиТопливаПоАвто Расход 
		Движение 				= Движения.ОстаткиТопливаПоАвто.Добавить();
		Движение.ВидДвижения 	= ВидДвиженияНакопления.Расход;
		Движение.Период 		= Дата;
		Движение.Машина 		= Машина;
		Движение.Количество 	= РасходВЛитрах;
		
	ИначеЕсли ВыборРежима = 2 Тогда
		
		Для Каждого текСтрока Из Список Цикл
			// регистр Пробег
			Движение 		= Движения.Пробег.Добавить();
			Движение.Период = Дата;
			Движение.Машина = ТекСтрока.Машина;
			Движение.Пробег = ТекСтрока.Пробег;
			
			// регистр ОстаткиТопливаПоАвто Расход 
			Движение 				= Движения.ОстаткиТопливаПоАвто.Добавить();
			Движение.ВидДвижения 	= ВидДвиженияНакопления.Расход;
			Движение.Период 		= Дата;
			Движение.Машина 		= ТекСтрока.Машина;
			Движение.Количество 	= ТекСтрока.РасходВЛитрах;
		КонецЦикла; 
		
	КонецЕсли;
			
	Движения.ОстаткиТопливаПоАвто.Записать();
			
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РасходТопливаПоПробегуСписок.Машина КАК Машина
		|ПОМЕСТИТЬ ВТ_Список
		|ИЗ
		|	Документ.РасходТопливаПоПробегу.Список КАК РасходТопливаПоПробегуСписок
		|ГДЕ
		|	РасходТопливаПоПробегуСписок.Ссылка = &Ссылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	РасходТопливаПоПробегу.Машина
		|ИЗ
		|	Документ.РасходТопливаПоПробегу КАК РасходТопливаПоПробегу
		|ГДЕ
		|	РасходТопливаПоПробегу.Ссылка = &Ссылка
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Машина
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОстаткиТопливаПоАвтоОстатки.Машина КАК Машина,
		|	ОстаткиТопливаПоАвтоОстатки.КоличествоОстаток КАК КоличествоОстаток
		|ПОМЕСТИТЬ ВТ_Остатки
		|ИЗ
		|	РегистрНакопления.ОстаткиТопливаПоАвто.Остатки(
		|			&МоментВремени,
		|			Машина В
		|				(ВЫБРАТЬ
		|					ВТ_Список.Машина КАК Машина
		|				ИЗ
		|					ВТ_Список КАК ВТ_Список)) КАК ОстаткиТопливаПоАвтоОстатки
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Машина
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Список.Машина КАК Машина,
		|	ЕСТЬNULL(ВТ_Остатки.КоличествоОстаток, 0) КАК Остаток
		|ИЗ
		|	ВТ_Список КАК ВТ_Список
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Остатки КАК ВТ_Остатки
		|		ПО ВТ_Список.Машина = ВТ_Остатки.Машина
		|ГДЕ
		|	ВТ_Остатки.КоличествоОстаток < 0";
	
	Запрос.УстановитьПараметр("МоментВремени", Новый Граница(МоментВремени(),ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Отказ = Истина;
		Текст = СтрШаблон("Недостаточно топлива для списания в кол-ве %1 л. под %2", 
			ВыборкаДетальныеЗаписи.Остаток, ВыборкаДетальныеЗаписи.Машина);
		Общий.СообщениеПользователю(Текст);
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты) 
	
	Ошибки 		= Новый Массив;
	ПоляОшибок 	= Новый Массив;
	
	Если ВыборРежима = 1 Тогда  
		
		Если НЕ ЗначениеЗаполнено(Машина) Тогда
			Ошибки.Добавить("Не заполнено Поле: Машина");
			ПоляОшибок.Добавить("Объект.Машина");
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Пробег) Тогда
			Ошибки.Добавить("Не заполнено Поле: Пробег");
			ПоляОшибок.Добавить("Объект.Пробег");
		КонецЕсли; 
		
		Если Расчитан Тогда 
			
			Если НЕ ЗначениеЗаполнено(РасходВЛитрах) Тогда
				Ошибки.Добавить("Документ не расчитан");
				ПоляОшибок.Добавить("Объект.РасходВЛитрах");
			КонецЕсли;
			
			Если РасходВЛитрах <= 0 Тогда
				Ошибки.Добавить("Расход не может быть меньше нуля"); 
				ПоляОшибок.Добавить("Объект.РасходВЛитрах"); 
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ВыборРежима = 2 Тогда
		Для Индекс = 0 По Список.Количество() - 1 Цикл
			
			Если НЕ ЗначениеЗаполнено(Список[Индекс].Машина) Тогда
				Ошибки.Добавить("Не заполнено Поле: Машина");
				Поле = СтрШаблон("Объект.Список[%1].Машина",Индекс);
				ПоляОшибок.Добавить(Поле);
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Список[Индекс].Пробег) Тогда
				Ошибки.Добавить("Не заполнено Поле: Пробег");
				Поле = СтрШаблон("Объект.Список[%1].Пробег",Индекс);
				ПоляОшибок.Добавить(Поле);
			КонецЕсли;
			
			Если Расчитан Тогда
				
				Если НЕ ЗначениеЗаполнено(Список[Индекс].РасходВЛитрах) Тогда
					Ошибки.Добавить("Документ не расчитан"); 
					Поле = СтрШаблон("Объект.Список[%1].РасходВЛитрах",Индекс);
					ПоляОшибок.Добавить(Поле);
				КонецЕсли;
				
				Если Список[Индекс].РасходВЛитрах <= 0 Тогда
					Ошибки.Добавить("Расход не может быть меньше нуля"); 
					Поле = СтрШаблон("Объект.Список[%1].РасходВЛитрах",Индекс);
					ПоляОшибок.Добавить(Поле); 
				КонецЕсли; 
				
			КонецЕсли;
			
		КонецЦикла; 
	КонецЕсли;
	
	Если Ошибки.Количество() > 0 Тогда 
		Отказ = Истина;
		Общий.СообщениеПользователюОЗаполнении(Ошибки, ПоляОшибок);
	КонецЕсли;
	
КонецПроцедуры  

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ЭтотОбъект.Ссылка.Пустая() Тогда
		РежимПроведения = РежимПроведенияДокумента.Оперативный;
	Иначе
		РежимПроведения = РежимПроведенияДокумента.Неоперативный;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти