
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтаФорма.Заголовок = Параметры.Заголовок;
    ЭтотОбъект.Группа = Параметры.Группа;
	Если Параметры.Режим = "Файлы" Тогда 
		ЭтотОбъект.Режим = "Файлы";
		Элементы.Группа2.Видимость = Истина;
		Элементы.Группа3.Видимость = Ложь;
	Иначе
		ЭтотОбъект.Режим = "Фрагменты";
		Элементы.Группа2.Видимость = Ложь;
		Элементы.Группа3.Видимость = Истина; 
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ГруппаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	Если Режим = "Файлы" Тогда
		ОткрытьФорму("Справочник.ВнешниеФайлы.ФормаВыбораГруппы");
	Иначе
		ОткрытьФорму("Справочник.ФрагментыКода.ФормаВыбораГруппы");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ФайлНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	Оповещение = Новый ОписаниеОповещения("ОписаниеЗавершения",ЭтотОбъект);
	НачатьПомещениеФайлаНаСервер(Оповещение);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СохранитьЭлемент(Команда)
	
	Если Режим = "Файлы" Тогда
		Запись = СохранитьФайлНаСервере(); 
	Иначе
		Запись = СохранитьФрагментКода();
	КонецЕсли;
	Если Запись Тогда
		ЭтаФорма.Закрыть(); 
	Иначе 
		ОбщегоНазначенияСервер.СообщениеПользователю("Ошибка сохранения");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область УправлениеДвоичнымиДанными
&НаКлиенте
Процедура ОписаниеЗавершения(ОписаниеПомещенногоФайла, Параметры) Экспорт
	
	Если ОписаниеПомещенногоФайла = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	АдресВХ 	= ОписаниеПомещенногоФайла.Адрес;
	Файл 		= ОписаниеПомещенногоФайла.СсылкаНаФайл.Имя;
	Расширение 	= ОписаниеПомещенногоФайла.СсылкаНаФайл.Расширение; 
	
КонецПроцедуры


#КонецОбласти
#Область РаботаСБазойДанных
&НаСервере
Функция СохранитьФрагментКода()
	
	Данные = ПолучитьДвоичныеДанныеИзСтроки(ТекстКода,КодировкаТекста.UTF8);

	НовыйФрагмент = Справочники.ФрагментыКода.СоздатьЭлемент();
	НовыйФрагмент.Наименование = Наименование;
	НовыйФрагмент.ОписаниеФрагментаКода = Описание;
	НовыйФрагмент.Родитель = Группа;
	НовыйФрагмент.ТекстКода = Новый ХранилищеЗначения(Данные);
	Для Каждого Строка из Теги Цикл
		НовыйТег = НовыйФрагмент.ТегиПоиска.Добавить();
		НовыйТег.Тег = Строка.Значение;
	КонецЦикла;
	Попытка
		НовыйФрагмент.Записать();
		Возврат Истина;
	Исключение 
		Возврат Ложь;
	КонецПопытки; 
КонецФункции 

 

&НаСервере
Функция СохранитьФайлНаСервере() 
	
	ДвоичныеДанные 	= ПолучитьИзВременногоХранилища(АдресВХ); 
	ПутьКФайлу 		= ПолучитьИмяВременногоФайла(Расширение);
	ДвоичныеДанные.Записать(ПутьКФайлу);
	
	НовыйЭлемент 				= Справочники.ВнешниеФайлы.СоздатьЭлемент();
	НовыйЭлемент.Наименование 	= Наименование;
	НовыйЭлемент.Родитель 		= Группа;
	НовыйЭлемент.Файл 			= Новый ХранилищеЗначения(ДвоичныеДанные);
	НовыйЭлемент.РазмерВложения = ДвоичныеДанные.Размер();
	НовыйЭлемент.ИмяФайла 		= Файл;
	НовыйЭлемент.ОписаниеФайла = Описание;
	
	Для каждого Строка из Теги Цикл
		СтрокаТЧ = НовыйЭлемент.ТегиПоиска.Добавить(); 
		СтрокаТЧ.Тег = Строка.Значение;
	КонецЦикла;
	Попытка
		НовыйЭлемент.Записать(); 
		УдалитьФайлы(ПутьКФайлу);
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки; 
	
КонецФункции
#КонецОбласти

#КонецОбласти










