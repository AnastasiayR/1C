#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Модификация 		= Новый Структура("Флаг,Ссылка");
	Модификация.Флаг	= Ложь;
	ПараметрыВрем 		= Новый Структура("АдресВХ,Расширение,ИмяФайла, Теги");
	Режим 				= "Файлы";
	
	УправлениеВидимостьДоступность(Неопределено); 
	
КонецПроцедуры


#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура РежимПриИзменении(Элемент)
	Если Модификация.Флаг = Ложь Тогда	
		ОчиститьГруппуФормы(); 

		Если Режим = "Файлы" Тогда
			Элементы.СписокФайлы.ТекущаяСтрока = 1;
			ПереходНаСтрокуФайла();
		Иначе
			Элементы.СписокФрагменты.ТекущаяСтрока = 1;
			ПереходНаСтрокуФрагмента();
		КонецЕсли;
	Иначе
		ПоказатьВопросПользователю();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СтрокаОтбораПриИзменении(Элемент)  
	СтрокаОтбор = СтрокаОтбора.выгрузитьзначения();
   	Список = ?(Режим = "Файлы", СписокФайлы,СписокФрагменты);
	Если СтрокаОтбора.Количество() <> 0 Тогда 
		Список.Параметры.УстановитьЗначениеПараметра("СтрокаОтбора",СтрокаОтбор);
		Список.Параметры.УстановитьЗначениеПараметра("КоличествоОтбор",СтрокаОтбор.Количество());
		Список.Параметры.УстановитьЗначениеПараметра("ПустойОтбор",Ложь);
	Иначе 
		Список.Параметры.УстановитьЗначениеПараметра("СтрокаОтбора",СтрокаОтбор);
		Список.Параметры.УстановитьЗначениеПараметра("КоличествоОтбор", 0);
		Список.Параметры.УстановитьЗначениеПараметра("ПустойОтбор",Истина);	
	КонецЕсли;  

КонецПроцедуры


#Область СтраницаФайлы 

&НаКлиенте
Процедура НаименованиеФайлаПриИзменении(Элемент)
	
	ПоставитьМодификациюОбъекту(Элементы.СписокФайлы.ТекущиеДанные.ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОписаниеФайлаПриИзменении(Элемент)
	
	ПоставитьМодификациюОбъекту(Элементы.СписокФайлы.ТекущиеДанные.ссылка);

КонецПроцедуры

#КонецОбласти

#Область СтраницаФрагментыКода 

&НаКлиенте
Процедура ГруппаФрагментаПриСменеСтраницы(Элемент, ТекущаяСтраница)
	Если ТекущаяСтраница = Элементы.Текст И ТекстКода = "" Тогда
		Элементы.ТекстКода.Доступность = Истина;
		ТекущийФрагмент = Элементы.СписокФрагменты.ТекущиеДанные.ССылка;
		ТекстКода = ПолучитьТекстССервера(ТекущийФрагмент); 
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НаименованиеКодаПриИзменении(Элемент)
	
	ПоставитьМодификациюОбъекту(Элементы.СписокФрагменты.ТекущиеДанные.Ссылка);
	
КонецПроцедуры   

&НаКлиенте
Процедура ОписаниеКодаПриИзменении(Элемент)
	
	ПоставитьМодификациюОбъекту(Элементы.СписокФрагменты.ТекущиеДанные.Ссылка); 
	
КонецПроцедуры

&НаКлиенте
Процедура ТекстКодаПриИзменении(Элемент)

	ПоставитьМодификациюОбъекту(Элементы.СписокФрагменты.ТекущиеДанные.Ссылка);

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокФайлы

&НаКлиенте
Процедура СписокФайлыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;  
	
КонецПроцедуры

&НаКлиенте
Процедура СписокФайлыПриАктивизацииСтроки(Элемент) 
	
	Если Модификация.Флаг = Ложь Тогда
		ПереходНаСтрокуФайла();
	ИначеЕсли Модификация.Флаг = Истина И Элементы.СписокФайлы.ТекущиеДанные.ССылка <> Модификация.Ссылка Тогда  
		ПоказатьВопросПользователю();
	КонецЕсли;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокФрагменты

&НаКлиенте
Процедура СписокФрагментыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;   
	
КонецПроцедуры

&НаКлиенте
Процедура СписокФрагментыПриАктивизацииСтроки(Элемент)
	
	Если Модификация.Флаг = Ложь Тогда
		ПереходНаСтрокуФрагмента(); 
	ИначеЕсли Модификация.Флаг = Истина и Элементы.СписокФрагменты.ТекущиеДанные.ссылка <> Модификация.ссылка Тогда
		ПоказатьВопросПользователю();
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СоздатьГруппа(Команда)
	
	Форма = ?(Режим = "Файлы","Справочник.ВнешниеФайлы.ФормаГруппы","Справочник.ФрагментыКода.ФормаГруппы"); 
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЭтоГруппа", Истина);
	ОткрытьФорму(Форма, ПараметрыФормы, ЭтаФорма); 
	
КонецПроцедуры


&НаКлиенте
Процедура ДобавитьФайл(Команда)
	
	Строка = ?(Режим = "Файлы", Элементы.СписокФайлы.ТекущиеДанные, Элементы.СписокФрагменты.ТекущиеДанные); 
	Если Строка =  Неопределено Тогда
		Группа = Неопределено;
	ИначеЕсли Строка.ЭтоГруппа Тогда
		Группа = Строка.Ссылка;
	Иначе
		Группа = Строка.Родитель;
	КонецЕсли;
    Заголовок  = ?(Режим = "Файлы", "Новый Внешний файл", "Новый Фрагмент кода"); 
	ПараметрыФормы = Новый Структура("Заголовок, Группа, Режим", Заголовок, Группа, Режим);
	ОткрытьФорму("Обработка.Библиотека.Форма.НовыйФайл", ПараметрыФормы,,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);      

КонецПроцедуры 

&НаКлиенте
Процедура УдалитьЭлемент(Команда)
	
	ВыбранныйЭлемент = ?(Режим = "Файлы", Элементы.СписокФайлы.ТекущиеДанные.Ссылка, Элементы.СписокФрагменты.ТекущиеДанные.Ссылка); 
	Если УдалитьФайлНаСервере(ВыбранныйЭлемент)Тогда
		ОбновитьДерево();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РедактироватьТеги(Команда)
	МассивТегов = ПараметрыВрем.Теги[0].Значение; 
	ДопПараметры = Новый Структура("Список", МассивТегов); 
	
	ПараметрыОткрытия = Новый Структура;
	
	ПараметрыОткрытия.Вставить("Лево", 200);
	ПараметрыОткрытия.Вставить("Топ", 100);

	ПараметрыОткрытия.Вставить("Ширина", 400);
	ПараметрыОткрытия.Вставить("Высота", 300);

	ПараметрыОткрытия.Вставить("РежимОткрытияОкна", РежимОсновногоОкнаКлиентскогоПриложения.Обычный);
	ОткрытьФорму("Обработка.Библиотека.Форма.РедактированиеТегов",ДопПараметры,, ПараметрыОткрытия,,,Новый ОписаниеОповещения("ЗавершениеРедактирования",ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьИзменения(Команда)
	Если Режим = "Файлы" Тогда 
		ПоставитьМодификациюОбъекту(Элементы.СписокФайлы.ТекущиеДанные.ссылка);
	Иначе
		ПоставитьМодификациюОбъекту(Элементы.СписокФрагменты.ТекущиеДанные.ссылка);
    КонецЕсли;
	СохранитьИзмененияЭлемента();
	
КонецПроцедуры 

&НаКлиенте
Процедура ОтменаИзменений(Команда) 
	
	СнятьМодификациюОбъекта();
	Если Режим = "Файлы" Тогда
		ПереходНаСтрокуФайла();
	Иначе
		ПереходНаСтрокуФрагмента();
	КонецЕсли;
	ЭтаФорма.ОбновитьОтображениеДанных();

КонецПроцедуры



#Область КомандыФайлы

&НаКлиенте
Процедура ВыгрузитьФайл(Команда)
	
	
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение); 
	Диалог.ПолноеИмяФайла = Элементы.СписокФайлы.ТекущиеДанные.ИмяФайла;
	Диалог.Фильтр = "Все Файлы |*.*|"; 
	Описание = Новый ОписаниеОповещения("ВыборПутиСохранения", ЭтотОбъект);
	Диалог.Показать(Описание);



КонецПроцедуры 

&НаКлиенте
Процедура Заменить(Команда)

	Описание = Новый ОписаниеОповещения("ЗавершениеПомещенияФайла",ЭтотОбъект);
	НачатьПомещениеФайлаНаСервер(Описание,,,,,ЭтаФорма.УникальныйИдентификатор);
	
КонецПроцедуры   


#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область УправлениеФормой

&НаСервере
Процедура УправлениеВидимостьДоступность(Данные)
	
	Если Режим = "Файлы" Тогда 
		Элементы.СписокФайлы.Видимость 			= Истина;
		Элементы.СписокФрагменты.Видимость		= Ложь;
		Элементы.СтраницаФайл.Видимость 		= Истина;
		Элементы.СтраницаФрагментКода.Видимость = Ложь;
		Элементы.ТекстКода.Доступность 			= Ложь; 
		
		Если Данные = Неопределено ИЛИ Данные.ЭтоГруппа Тогда 
			Элементы.НаименованиеФайла.Доступность 	= Ложь;
			Элементы.ИмяФайла.Доступность 			= Ложь; 
			Элементы.ОписаниеФайла.Доступность 		= Ложь;
            Элементы.ТегиФайла.Доступность 			= Ложь;
			Элементы.РедактироватьТеги1.Доступность = Ложь;
			Элементы.Заменить.Доступность 			= Ложь;
			Элементы.ВыгрузитьФайл.Доступность 		= Ложь;
			Элементы.СохранитьИзменения.Доступность = Ложь;
			Элементы.ОтменаИзменений1.Доступность 	= Ложь;
		ИначеЕсли НЕ Данные.ЭтоГруппа Тогда 
			Элементы.НаименованиеФайла.Доступность 	= Истина;
			Элементы.ИмяФайла.Доступность 			= Истина; 
			Элементы.ОписаниеФайла.Доступность 		= Истина;
            Элементы.ТегиФайла.Доступность 			= Истина;
			Элементы.РедактироватьТеги1.Доступность = Истина;
			Элементы.Заменить.Доступность 			= Истина;
			Элементы.ВыгрузитьФайл.Доступность 		= Истина;
			Элементы.СохранитьИзменения.Доступность = Истина;  
			Элементы.ОтменаИзменений1.Доступность 	= Истина;

		КонецЕсли;

	Иначе
		Элементы.СписокФайлы.Видимость 			= Ложь;
		Элементы.СписокФрагменты.Видимость		= Истина;
		Элементы.СтраницаФайл.Видимость 		= Ложь;
		Элементы.СтраницаФрагментКода.Видимость = Истина; 
		Элементы.ТекстКода.Доступность 			= Ложь; 
		
		Если Данные = Неопределено ИЛИ Данные.ЭтоГруппа Тогда 
			Элементы.НаименованиеКода.Доступность 		= Ложь;
			Элементы.ОписаниеКода.Доступность			= Ложь; 
			Элементы.ТегиКода.Доступность 				= Ложь;
			Элементы.РедактироватьТеги.Доступность 		= Ложь;
			Элементы.СохранитьИзменения1.Доступность 	= Ложь;
			Элементы.ОтменаИзменений.Доступность 		= Ложь;
		ИначеЕсли НЕ Данные.ЭтоГруппа Тогда 
			Элементы.НаименованиеКода.Доступность 		= Истина;
			Элементы.ОписаниеКода.Доступность 			= Истина; 
			Элементы.ТегиКода.Доступность 				= Истина;
			Элементы.РедактироватьТеги.Доступность 		= Истина;
			Элементы.СохранитьИзменения1.Доступность 	= Истина; 
			Элементы.ОтменаИзменений.Доступность 		= Ложь;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте 
Процедура ОбновитьДерево()
		Если Режим = "Файлы" Тогда
			Элементы.СписокФайлы.Обновить();
		Иначе
			Элементы.СписокФрагменты.Обновить(); 
		КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПереходНаСтрокуФрагмента()
    ОчиститьГруппуФормы();
	ТекущийФрагмент = Элементы.СписокФрагменты.ТекущиеДанные;
	УправлениеВидимостьДоступность(ТекущийФрагмент);
	Если ТекущийФрагмент <> Неопределено Тогда
		Если Не ТекущийФрагмент.ЭтоГруппа Тогда
			Элементы.Текст.Видимость = Истина;
			Элементы.ГруппаФрагмента.ТекущаяСтраница = Элементы.Описание;
			ТекстКода = Неопределено;
			Элементы.ТекстКода.Доступность = Ложь; 
			НаименованиеКода = ТекущийФрагмент.Наименование;
			ОписаниеКода = ТекущийФрагмент.ОписаниеФрагментаКода; 
			ТегиКода = ПолучитьТегиСтрока(ТекущийФрагмент.Ссылка);
		Иначе   
			Элементы.Текст.Видимость = Ложь;
			ТекстКода = Неопределено;
			Элементы.ТекстКода.Доступность = Ложь; 

		КонецЕсли; 
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ПереходНаСтрокуФайла()
	ОчиститьГруппуФормы();
	ТекущиеДанные = Элементы.СписокФайлы.ТекущиеДанные; 
	УправлениеВидимостьДоступность(ТекущиеДанные);

	Если ТекущиеДанные <> Неопределено Тогда 
		Если Не  ТекущиеДанные.ЭтоГруппа Тогда 
			ОписаниеФайла = ТекущиеДанные.ОписаниеФайла; 
			НаименованиеФайла = ТекущиеДанные.Наименование;
			ИмяФайла = ТекущиеДанные.ИмяФайла;
			ТегиФайла = ПолучитьТегиСтрока(ТекущиеДанные.Ссылка);
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ПолучитьТегиСтрока(Объект)
	
	ТекОбъект = Объект.ПолучитьОбъект();
	Колонка = ТекОбъект.ТегиПоиска.ВыгрузитьКолонку("Тег");
	СтрокаТеги = СтрСоединить(Колонка,";");
	ПараметрыВрем.Теги = Новый СписокЗначений;
	ПараметрыВрем.Теги.Добавить(Колонка,СтрокаТеги); 
	Возврат ПараметрыВрем.Теги[0].Представление;
КонецФункции

// Возврат Результата закрытия Формы редактирования Набора Тегов
&НаКлиенте
Процедура ЗавершениеРедактирования(РезультатЗакрытия,Параметры) Экспорт 
	Если РезультатЗакрытия <> Неопределено Тогда
		ПараметрыВрем.Теги = Новый СписокЗначений;
		ПараметрыВрем.Теги.Добавить(РезультатЗакрытия, СтрСоединить(РезультатЗакрытия, ";"));
		Если Режим = "Файлы" Тогда
			ТегиФайла = ПараметрыВрем.Теги[0].Представление; 
			ПоставитьМодификациюОбъекту(Элементы.СписокФайлы.ТекущиеДанные.ссылка);
		Иначе
			ТегиКода = ПараметрыВрем.Теги[0].Представление; 
			ПоставитьМодификациюОбъекту(Элементы.СписокФрагменты.ТекущиеДанные.ссылка);
		КонецЕсли;      
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ОчиститьГруппуФормы()
	ОписаниеФайла = Неопределено;
	НаименованиеФайла = Неопределено;
    ИмяФайла = Неопределено;
	ТегиФайла = Неопределено;
	ОписаниеКода = Неопределено;
	ТекстКода = Неопределено;
	НаименованиеКода = Неопределено;
	ТегиКода=Неопределено;
	Для Каждого Параметр Из ПараметрыВрем Цикл 
		ПараметрыВрем[Параметр.Ключ] = Неопределено;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПоставитьМодификациюОбъекту(Ссылка)
	Модификация.Флаг = Истина;
	Модификация.Ссылка = Ссылка;
КонецПроцедуры   

&НаКлиенте
ПРоцедура СнятьМодификациюОбъекта()
	
	Модификация.Флаг = Ложь;
	Модификация.Ссылка = Неопределено;  
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВопросПользователю() 
	
	ПоказатьВопрос(Новый ОписаниеОповещения("ОбработкаОтвета",ЭтотОбъект),
			"Данные Изменены. Сохранить изменения?", РежимДиалогаВопрос.ДаНетОтмена);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОтвета(РезультатВопроса,Параметры) Экспорт 
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		СохранитьИзмененияЭлемента();
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		СнятьМодификациюОбъекта();
		УправлениеВидимостьДоступность(Элементы.СписокФайлы.ТекущиеДанные );
		Если ПараметрыВрем.АдресВХ <> Неопределено Тогда
			УдалитьИзВременногоХранилища(ПараметрыВрем.АдресВХ);
		КонецЕсли;
		Если Режим = "Файлы" Тогда 
			ПереходНаСтрокуФайла();
		Иначе
			ПереходНаСтрокуФрагмента();
		КонецЕсли;
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Отмена Тогда
		Если ТипЗнч(Модификация.ссылка) = Тип("СправочникСсылка.ВнешниеФайлы") Тогда 
			Режим = "Файлы";
			Элементы.СписокФайлы.ТекущаяСтрока = Модификация.Ссылка;
		Иначе
			Режим = "ФрагментыКода" ;
			Элементы.СписокФрагменты.ТекущаяСтрока = Модификация.Ссылка;
		КонецЕсли;
		ЭтаФорма.ОбновитьОтображениеДанных();
	КонецЕсли;	
	ЭтаФорма.ОбновитьОтображениеДанных();
КонецПроцедуры

#КонецОбласти


#Область УправлениеОбъектамиБД  

&НаСервере
Функция УдалитьФайлНаСервере(Данные) 
	
	СсылкаОбъект = Данные.ПолучитьОбъект();
	Попытка 
		СсылкаОбъект.Удалить(); 
		Возврат Истина
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции


&НаКлиенте
Процедура СохранитьИзмененияЭлемента()
	Проверка = ПроверкаЗаполнения();
	Если Не Проверка.Результат Тогда
		Текст = СтрШаблон("Не заполнены обязательные Поля: %1", СтрСоединить(Проверка.Поля,";"));
		ОбщегоНазначенияСервер.СообщениеПользователю(Текст); 
		Если ТипЗнч(Модификация.ссылка)= Тип("СправочникСсылка.ВнешниеФайлы")Тогда
			Элементы.СписокФайлы.ТекущаяСтрока = Модификация.Ссылка;
		Иначе
			Элементы.СписокФрагменты.ТекущаяСтрока = Модификация.ссылка; 
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Записано = ?(ТипЗнч(Модификация.ссылка)= Тип("СправочникСсылка.ВнешниеФайлы"),
		СохранитьФайлНаСервер(Модификация.Ссылка),СохранитьФрагментНаСервер(Модификация.ссылка));
	Если Записано Тогда
		ОповеститьОбИзменении(Модификация.Ссылка);
		СнятьМодификациюОбъекта();
	Иначе
		ОбщегоНазначенияСервер.СообщениеПользователю("Ошибка Записи Файла");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПроверкаЗаполнения ()
	РезультатПроверки = Новый Структура("Результат, Поля", Истина, Новый Массив);
	Если Режим = "Файлы" Тогда
		Если Не ЗначениеЗаполнено(ЭтотОбъект.ИмяФайла) Тогда
			РезультатПроверки.Поля.Добавить("Файл");
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ЭтотОбъект.ОписаниеФайла) Тогда
			РезультатПроверки.Поля.Добавить("Описание файла");
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ЭтотОбъект.НаименованиеФайла) Тогда
			РезультатПроверки.Поля.Добавить("Наименование");
		КонецЕсли;
	Иначе
		Если Не ЗначениеЗаполнено(ЭтотОбъект.ОписаниеКода) Тогда
			РезультатПроверки.Поля.Добавить("Описание");
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ЭтотОбъект.НаименованиеКода) Тогда
			РезультатПроверки.Поля.Добавить("Наименование");
		КонецЕсли;
		Если (Элементы.ТекстКода.Доступность и Не ЗначениеЗаполнено(ЭтотОбъект.ТекстКода)) Тогда
			 РезультатПроверки.Поля.Добавить("Текст кода");
		 КонецЕсли;
	 КонецЕсли; 
	 Если РезультатПроверки.Поля.Количество() <> 0 Тогда
		 РезультатПроверки.Результат = Ложь;
		КонецЕсли;
	Возврат РезультатПроверки;
КонецФункции 

&НаСервере
Функция СохранитьФайлНаСервер(СсылкаОбъект)
	
	ТекущийФайл 				= СсылкаОбъект.ПолучитьОбъект(); 
	ТекущийФайл.Наименование 	= ЭтотОбъект.НаименованиеФайла;
	ТекущийФайл.ОписаниеФайла 	= ЭтотОбъект.ОписаниеФайла; 
	
	ТекущийФайл.ТегиПоиска.Очистить();
    Для каждого Тег Из ПараметрыВрем.Теги[0].Значение Цикл
		Новаястрока = ТекущийФайл.ТегиПоиска.Добавить();
		НоваяСтрока.Тег = Тег;
	КонецЦикла; 
	
	Если ПараметрыВрем.АдресВХ <> Неопределено Тогда 
		ДвоичныеДанные 	= ПолучитьИзВременногоХранилища(ПараметрыВрем.АдресВХ);
		ПутьКФайлу 		= ПолучитьИмяВременногоФайла(ПараметрыВрем.Расширение);
		ДвоичныеДанные.Записать(ПутьКФайлу);
		
		ТекущийФайл.Файл 			= Новый ХранилищеЗначения(ДвоичныеДанные); 
		ТекущийФайл.ИмяФайла 		= ПараметрыВрем.ИмяФайла;
		ТекущийФайл.РазмерВложения 	= ДвоичныеДанные.Размер();
	КонецЕсли;
	
	Попытка 
		ТекущийФайл.Записать();
		Если ПараметрыВрем.АдресВХ <> Неопределено Тогда 
			УдалитьФайлы(ПутьКФайлу); 
		КонецЕсли;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;		
КонецФункции 

&НаСервере
Функция СохранитьФрагментНаСервер(СсылкаОбъект)
	
	ТекущийФрагмент 						= СсылкаОбъект.ПолучитьОбъект(); 
	ТекущийФрагмент.Наименование 			= ЭтотОбъект.НаименованиеКода;
	ТекущийФрагмент.ОписаниеФрагментаКода 	= ЭтотОбъект.ОписаниеКода;
	ТекущийФрагмент.ТегиПоиска.Очистить();
	Для каждого Тег Из ПараметрыВрем.Теги[0].Значение Цикл
		Новаястрока 	= ТекущийФрагмент.ТегиПоиска.Добавить();
		НоваяСтрока.Тег = Тег;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ЭтотОбъект.ТекстКода) Тогда
		ДвоичныеДанные				= ПолучитьДвоичныеДанныеИзСтроки(ЭтотОбъект.ТекстКода,КодировкаТекста.UTF8);
	 	ТекущийФрагмент.ТекстКода 	= Новый ХранилищеЗначения(ДвоичныеДанные);	
	КонецЕсли;
	
	Попытка 
		ТекущийФрагмент.Записать();
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки; 
	
КонецФункции

#КонецОбласти
 
#Область РаботасДвоичнымиДаннымииФайлами

&НаСервере
Функция ПолучитьАдресВХНаСервере(ТекущиеДанные)
	
	Хранилище 	= ТекущиеДанные.Файл;
	Данные 		= Хранилище.Получить();
	АдресВХ = ПоместитьВоВременноеХранилище(Данные,ЭтаФорма.УникальныйИдентификатор);
	Возврат АдресВХ
		
КонецФункции


&НаСервере
Функция ПолучитьТекстССервера(ТекущийФрагмент)
	
	Хранилище 		= ТекущийФрагмент.ТекстКода; 
	ДвоичныеДанные 	= Хранилище.Получить();
	Если ДвоичныеДанные <> Неопределено Тогда
		СтрокаКода = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные,КодировкаТекста.UTF8);
	Иначе 
		СтрокаКода = "";
	КонецЕсли;
	
	Возврат СтрокаКода; 
	
КонецФункции

&НаКлиенте
Процедура ЗавершениеПомещенияФайла(ОписаниеПомещенногоФайла, Параметры) Экспорт
	Если ОписаниеПомещенногоФайла <> Неопределено Тогда 
		ПараметрыВрем.АдресВХ = ОписаниеПомещенногоФайла.Адрес;
		ПараметрыВрем.ИмяФайла = ОписаниеПомещенногоФайла.СсылкаНаФайл.Имя;
		ПараметрыВрем.Расширение = ОписаниеПомещенногоФайла.СсылкаНаФайл.Расширение;
		ЭтотОбъект.ИмяФайла = ПараметрыВрем.ИмяФайла; 
		ПоставитьМодификациюОбъекту(Элементы.СписокФайлы.ТекущиеДанные.Ссылка);
	Иначе
		Возврат;
	КонецЕсли;
			
КонецПроцедуры 

&НаКлиенте
Процедура ВыборПутиСохранения(ВыбранныеФайлы, Параметры) Экспорт
	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПутьКФайлу = ВыбранныеФайлы[0];  
	ДанныеФайла = ПолучитьАдресВХНаСервере(Элементы.СписокФайлы.ТекущиеДанные.Ссылка);
	НачатьПолучениеФайлаССервера(,ДанныеФайла,ПутьКФайлу);
	
КонецПроцедуры
	
#КонецОбласти


